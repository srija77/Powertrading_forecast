# Normalise line endings so the repo is identical on Windows, macOS and Linux.
# Without this, files committed from Windows carry CRLF and every checkout on a
# Unix machine shows the whole file as changed.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or cmd.exe mis-parses them.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touch binary payloads.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.parquet binary
*.pkl binary
*.joblib binary
*.h5 binary
*.onnx binary
*.zip binary
*.gz binary

# Notebooks and lockfiles: keep diffs readable, avoid bogus merge attempts.
*.ipynb text eol=lf
requirements.txt text eol=lf
