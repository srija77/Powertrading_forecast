# Copy this file to .env and fill in the values for your machine.
#   cp .env.example .env        (Git Bash)
#   Copy-Item .env.example .env (PowerShell)
#
# .env is gitignored and must never be committed. This template is committed so a
# fresh clone knows which variables the pipeline reads.

# --- Data lineage (src/lineage.py) -----------------------------------------
# Marquez API. Start the stack with:
#   docker compose -f marquez-docker-compose.yml up -d
# UI at http://localhost:3001
OPENLINEAGE_URL=http://localhost:5002
# Set to true to skip lineage emission entirely (no Marquez needed).
OPENLINEAGE_DISABLED=false

# --- MLflow (training, evaluation, promotion, prediction) -----------------
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Validation targets (src/2_validation/*) ------------------------------
# Postgres connection used to publish validation results.
POSTGRES_URL=postgresql://user:password@localhost:5432/powertrading

# S3 / MinIO credentials for validation artifacts. Leave blank to skip uploads.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
