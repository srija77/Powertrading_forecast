    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": { "column": "Final Scheduled Volume (MW)", "min_value": 0 }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": { "column": "MCP (Rs/MWh) *", "min_value": 0, "max_value": 20000 }
